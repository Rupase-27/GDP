#include <SimpleFOC.h>

// SENSORS (3x SPI Magnetic Encoders)
MagneticEncoderSPI encoder1 = MagneticEncoderSPI(AS5048A_SPI, D10); // Motor 1 (Guidewire Translation) 
MagneticEncoderSPI encoder2 = MagneticEncoderSPI(AS5048A_SPI, PB12);  // Motor 2 (Guidewire Rotation) 
MagneticEncoderSPI encoder3 = MagneticEncoderSPI(AS5048A_SPI, PB11);  // Motor 3 (Catheter Translation) 

/ DRIVERS (3x 3-PWM Drivers)
BLDCDriver3PWM driver1 =BLDCDriver3PWM(PA8, PA9, PA10, PB1);  
BLDCDriver3PWM driver2 = BLDCDriver3PWM(PA4, PC7, PB0, PB5);  
BLDCDriver3PWM driver3 = BLDCDriver3PWM(PB2, PB4, PB9, PB10); 

// MOTORS (11 Pole Pairs - adjust if your hardware differs)
BLDCMotor motor1 = BLDCMotor(11); 
BLDCMotor motor2 = BLDCMotor(11); 
BLDCMotor motor3 = BLDCMotor(11); 

// SAFETY & LIMIT SWITCH PINS
const int LIMIT_SWITCH_1 = PB13; // Guidewire translation home switch 
const int LIMIT_SWITCH_3 = PB14; // Catheter translation home switch 
const int ESTOP_PIN      = PC3; // Hardwired Emergency Stop button 

// Target positions (in radians) 
float target_angle1 = 0; 
float target_angle2 = 0; 
float target_angle3 = 0; 

// Snag Detection Threshold
const float MAX_TRACKING_ERROR = 0.4; // Max allowable angle lag in radians before flagging a snag 

// USER INTERFACE (SimpleFOC Commander for live tuning)
Commander commander = Commander(Serial);
void onMotor1(char* cmd){ commander.motor(&motor1, cmd); }
void void onMotor2(char* cmd){ commander.motor(&motor2, cmd); } // Fixed typo below
void onMotor2(char* cmd){ commander.motor(&motor2, cmd); }
void onMotor3(char* cmd){ commander.motor(&motor3, cmd); }

void setup() {  
  Serial.begin(115200); 
  delay(1000);  
  Serial.println("Initializing 3-Axis Medical Robot with FOC, Homing, & Commander...");  

  // Configure safety and limit switch pins  
  pinMode(LIMIT_SWITCH_1, INPUT_PULLUP);  
  pinMode(LIMIT_SWITCH_3, INPUT_PULLUP);  
  pinMode(ESTOP_PIN, INPUT_PULLUP);  

  // Initialize Encoders  
  encoder1.init(); 
  encoder2.init(); 
  encoder3.init();  

  // Initialize Drivers (Change 12 to your actual power supply voltage)
  driver1.voltage_power_supply = 12; driver1.init();  
  driver2.voltage_power_supply = 12; driver2.init();  
  driver3.voltage_power_supply = 12; driver3.init();  

  // Link Drivers and Sensors to Motors
  motor1.linkDriver(&driver1); motor1.linkSensor(&encoder1);
  motor2.linkDriver(&driver2); motor2.linkSensor(&encoder2);
  motor3.linkDriver(&driver3); motor3.linkSensor(&encoder3);

  // Set initial open-loop mode for safe homing  
  motor1.voltage_limit = 2; motor1.controller = MotionControlType::velocity_openloop; motor1.init();  
  motor2.voltage_limit = 2; motor2.controller = MotionControlType::velocity_openloop; motor2.init();  
  motor3.voltage_limit = 2; motor3.controller = MotionControlType::velocity_openloop; motor3.init();  

  // Homing routine for translation axes  
  Serial.println("Homing translation axes...");  
  homeAxis(&motor1, LIMIT_SWITCH_1, -1.0);  
  homeAxis(&motor3, LIMIT_SWITCH_3, -1.0);  

  // Switch to Closed-Loop Position (Angle) Control & Initialize FOC alignment
  motor1.controller = MotionControlType::angle;  
  motor2.controller = MotionControlType::angle;  
  motor3.controller = MotionControlType::angle;  
  
  motor1.voltage_limit = 3; motor1.P_angle.P = 20; motor1.initFOC();  
  motor2.voltage_limit = 3; motor2.P_angle.P = 20; motor2.initFOC();  
  motor3.voltage_limit = 3; motor3.P_angle.P = 20; motor3.initFOC();  

  // Register Commander commands for live tuning via Serial Monitor
  // e.g., type '1P30' to change motor 1 P-gain, or '1Ctarget'
  commander.add('1', onMotor1, "motor 1");
  commander.add('2', onMotor2, "motor 2");
  commander.add('3', onMotor3, "motor 3");

  Serial.println("System fully homed and active. Ready.");  
}  

void loop() {  
  // 1. Check hardware interlocks and E-stop first  
  checkSafetyInterlocks();  

  // 2. Continuously update FOC commutation loops  
  motor1.loopFOC();  
  motor2.loopFOC();  
  motor3.loopFOC();  

  // 3. Drive motors to target angles  
  motor1.move(target_angle1);  
  motor2.move(target_angle2);  
  motor3.move(target_angle3);  

  // 4. Resistance / Snag detection control
  checkSnagResistance();  

  // 5. Run SimpleFOC Commander (for live debugging/tuning)
  commander.run();

  // 6. Custom XML Serial Protocol Handler (for external GUI or scripts)
  if (Serial.available()) {  
    String packet = Serial.readStringUntil('\n');  
    packet.trim();  
     
    if (packet.startsWith("<") && packet.endsWith(">")) {  
      char cmd = packet.charAt(1);  
      float val = packet.substring(3, packet.length() - 1).toFloat();  
      float target_radians = val * (PI / 180.0); // convert degrees to radians

     if (cmd == 'X') { triggerEmergencyStop(); }  
    }  
  }  
}  

void checkSnagResistance() {  
  float error1 = abs(target_angle1 - encoder1.getAngle());  
  float error3 = abs(target_angle3 - encoder3.getAngle());  

  if (error1 > MAX_TRACKING_ERROR) {  
    Serial.println("ALERT: Snag detected on Guidewire Translation (Axis 1)");  
    triggerEmergencyStop();  
  }  
  if (error3 > MAX_TRACKING_ERROR) {  
    Serial.println("ALERT: Snag detected on Catheter Translation (Axis 3)");  
    triggerEmergencyStop();  
  }  
}  

void homeAxis(BLDCMotor* motor, int limitPin, float searchVelocity) {  
  while (digitalRead(limitPin) == HIGH) {  
    if (digitalRead(ESTOP_PIN) == HIGH) { triggerEmergencyStop(); }  
    motor->loopFOC();  
    motor->move(searchVelocity);  
  }  
  motor->move(0);  
  delay(200);  
}  

void checkSafetyInterlocks() {  
  if (digitalRead(ESTOP_PIN) == HIGH) {  
    triggerEmergencyStop();  
  }  
}  

void triggerEmergencyStop() {  
  Serial.println("EMERGENCY STOP: Halting all motor drivers.");  
  while (true) {  
    motor1.disable();  
    motor2.disable();  
    motor3.disable();  
  }  
}
